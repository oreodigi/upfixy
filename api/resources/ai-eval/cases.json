        {"ref": "t", "host": "kala.example.com", "kind": "tls", "severity": "critical", "code": "TLS_EXPIRED", "recent": {"failed": 6, "cycles": 6}, "facts": {"days_left": -2, "verified": false, "subject_cn": "kala.example.com", "issuer_cn": "R10"}},
