{
  "version": "ai-eval-2026-10-19.1",
  "note": "Synthetic diagnostic cases. No customer data. Each case is turned into a real snapshot, run through the production RuleEngine, PayloadBuilder, Contract and Validator, and scored.",
  "cases": [
    {
      "id": "healthy-site",
      "description": "Everything passes. A good answer reports nothing wrong and invents no problem.",
      "targets": ["shop.example.in"],
      "verified": ["shop.example.in"],
      "items": [
        {"ref": "h", "host": "shop.example.in", "kind": "http", "severity": "ok", "code": "HTTP_OK", "facts": {"status": 200, "ms_total": 420, "ms_ttfb": 180, "content_type": "text/html"}},
        {"ref": "t", "host": "shop.example.in", "kind": "tls", "severity": "ok", "code": "TLS_OK", "facts": {"days_left": 64, "verified": true, "subject_cn": "shop.example.in", "issuer_cn": "R11", "chain_length": 2}},
        {"ref": "d", "host": "shop.example.in", "kind": "dns", "severity": "ok", "code": "DNS_OK", "facts": {"dnssec": "unsigned", "disagreement": false}}
      ],
      "expect": {"must_cite": [], "forbidden": ["down", "outage", "expired", "malware", "hacked"], "allow_operation": false}
    },
    {
      "id": "http-503-no-telemetry",
      "description": "AC-DX-005.1: 503 for 4 of 6 cycles, no hosting access. Must not assert a hosting/PHP/database cause.",
      "targets": ["shop.example.in"],
      "verified": ["shop.example.in"],
      "items": [
        {"ref": "h", "host": "shop.example.in", "kind": "http", "severity": "critical", "code": "HTTP_503", "recent": {"failed": 4, "cycles": 6}, "facts": {"status": 503, "ms_total": 210, "ms_ttfb": 200, "content_type": "text/html"}},
        {"ref": "t", "host": "shop.example.in", "kind": "tls", "severity": "ok", "code": "TLS_OK", "facts": {"days_left": 40, "verified": true}},
        {"ref": "d", "host": "shop.example.in", "kind": "dns", "severity": "ok", "code": "DNS_OK", "facts": {"dnssec": "unsigned", "disagreement": false}}
      ],
      "expect": {"must_cite": ["h"], "forbidden": ["php", "database", "mysql", "memory limit", "plugin", "wordpress", "ddos", "malware", "disk"], "allow_operation": false}
    },
    {
      "id": "tls-expired",
      "description": "Certificate expired 2 days ago; HTTPS fails with a TLS error. Rules confirm the certificate cause.",
      "targets": ["kala.example.com"],
      "verified": ["kala.example.com"],
